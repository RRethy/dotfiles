[user]
    name = Adam P. Regasz-Rethy
    email = adam.regaszrethy@airbnb.com
[commit]
    verbose = true
[pull]
    rebase = true
[rerere]
    enabled = true
[merge]
    tool = fugitive
[mergetool "fugitive"]
    cmd = nvim -f -c "Gdiff" "$MERGED"
[diff]
    tool = nvimdiff
[difftool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE
    trustExitCode = true
[alias]
    default = !git checkout $(git symbolic-ref refs/remotes/origin/HEAD --short | sed -En 's|^.*/||p')
    co = checkout
    st = status
    up = fetch --all
    b  = branch --sort=committerdate
    pls = push --force-with-lease
    cc = !git add -A && git commit -av
    ca = !git add -A && git commit --amend -av
    cas = !git add -A && git commit --amend --no-edit
    foor = branch
    rn = "!f() { git branch -m $1; }; f"
    rh = reset --hard
    rhu = reset --hard @{u}
    cp = cherry-pick
    cob = !git checkout $(git branch --sort=committerdate | fzf)
    d = diff --cached --diff-algorithm=minimal
    dt = "!f() { nvim -c \"Git difftool -y ${1:-HEAD~1}\"; }; f"
[credential "https://git.musta.ch"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[core]
	fsmonitor = true
[feature]
	manyFiles = true
